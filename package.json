{
  "name": "pathixo-rewards",
  "version": "0.1.0",
  "private": true,
  "description": "Pathixo Rewards — Get paid while AI thinks. A high-yield browser extension and ad monetization platform.",
  "scripts": {
    "dev:extension": "pnpm --filter @pathixo/extension dev",
    "build:extension": "pnpm --filter @pathixo/extension build",
    "zip:extension": "pnpm --filter @pathixo/extension zip",
    "dev:web": "pnpm --filter @pathixo/web dev",
    "build:web": "pnpm --filter @pathixo/web build",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/deploy-gh-pages.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "check:all": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run qa:all",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:selectors": "node scripts/qa/verify-selectors.mjs",
    "canary:selectors": "node scripts/canary-selectors.mjs",
    "audit:store-compliance": "node scripts/qa/audit-store-compliance.mjs",
    "simulate:antifraud": "node scripts/qa/simulate-antifraud.mjs",
    "audit:financials": "node scripts/qa/audit-financials.mjs",
    "simulate:stream": "node scripts/qa/simulate-stream.mjs",
    "qa:all": "node scripts/qa/qa-all.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
