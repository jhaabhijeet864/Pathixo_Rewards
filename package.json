{
  "name": "pathixo-rewards",
  "version": "0.1.0",
  "private": true,
  "description": "Pathixo Rewards — Get paid while AI thinks. A high-yield browser extension and ad monetization platform.",
  "scripts": {
    "dev:extension": "pnpm --filter @pathixo/extension dev",
    "build:extension": "pnpm --filter @pathixo/extension build",
