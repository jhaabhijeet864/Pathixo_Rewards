# Pathixo Rewards Environment Configuration
# Copy this file to .env.local for local development

NODE_ENV=development
PORT=3000

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database (PostgreSQL) - Required for persistent production storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathixo_rewards?schema=public

# Ad Engine & Security Secrets
AD_TOKEN_SIGNING_SECRET=replace_with_a_secure_random_string_in_production
CRON_SECRET=replace_with_cron_secret_for_scheduled_tasks

# Payout Rails
MIN_CASHOUT_USD=2.00
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
UPI_MERCHANT_KEY=
UPI_VPA_ENDPOINT=

# Stripe Billing (Advertiser Self-Serve Portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Fallback Affiliate Switches (100% fill rate guarantee)
ENABLE_AFFILIATE_FALLBACK=true
